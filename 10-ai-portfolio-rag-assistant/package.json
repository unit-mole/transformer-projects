{
  "name": "ai-portfolio-rag-assistant",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests-ts/*.test.mjs",
    "validate:data": "node scripts-node/validate-data.mjs",
    "test:python": "python -m pytest -q",
    "evaluate:summary": "python scripts/build_evaluation_summary.py",
    "ci": "npm run validate:data && npm run test && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@huggingface/inference": "4.13.23",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "5.9.2"
  }
}
