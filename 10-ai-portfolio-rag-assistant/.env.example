# -----------------------------------------------------------------------------
# AI Portfolio RAG Assistant — server-side configuration
# -----------------------------------------------------------------------------
# The checked-in starter build works without secrets. Before the final portfolio
# launch, generate real MiniLM/E5 document embeddings and configure the SAME model
# here so the Vercel API can embed user questions in the same vector space.

HF_API_TOKEN=
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional hosted instruction Transformer. Keep false until the selected model is
# available through your Hugging Face Inference Provider account.
USE_HF_GENERATOR=false
HF_GENERATOR_MODEL=google/gemma-2-2b-it

# Retrieval confidence threshold used by the grounded fallback composer.
MIN_RETRIEVAL_SCORE=0.15

NEXT_PUBLIC_APP_NAME=AI Portfolio RAG Assistant
NEXT_PUBLIC_GITHUB_URL=https://github.com/unit-mole/transformer-projects
NEXT_PUBLIC_VERCEL_URL=
