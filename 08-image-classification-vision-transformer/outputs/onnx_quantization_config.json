{
  "quantization_method": "dynamic",
  "candidate_types": [
    "QUInt8",
    "QInt8"
  ],
  "operators_to_quantize": [
    "MatMul",
    "Gemm"
  ],
  "per_channel_requested": true,
  "reduce_range": false,
  "validation_dataset": "CIFAR-10 test set",
