    1,
    7,
    32
  ],
  "latency_warmup_iterations": 30,
  "latency_timed_iterations": 200,
  "execution_provider": "CPUExecutionProvider",
  "acceptance_thresholds": {
    "minimum_prediction_agreement": 0.995,
    "maximum_accuracy_drop": 0.003,
    "maximum_macro_f1_drop": 0.003,
    "minimum_size_reduction": 0.4
  }
}