{
  "project_name": "02-neural-machine-translation-transformer",
  "inference_mode": "pretrained_directional_models",
  "en_hi_model_id": "Helsinki-NLP/opus-mt-en-hi",
  "hi_en_model_id": "Helsinki-NLP/opus-mt-hi-en",
  "tokenizer_source": "same_as_directional_model",
  "generation_config": {
    "num_beams": 4,
    "max_source_length": 512,
    "max_new_tokens": 256,
    "early_stopping": true,
    "length_penalty": 1.0,
    "no_repeat_ngram_size": 3,
    "renormalize_logits": true
  },
  "dataset_reference": "cfilt/iitb-english-hindi",
  "preprocessing": {
    "unicode_normalization": "NFKC",
    "preserve_devanagari": true,
    "remove_html_tags": true,
    "collapse_whitespace": true
  },
  "confidence_scoring_method": "Exponentiated normalized beam sequence score; documented heuristic fallback",
  "confidence_is_calibrated": false,
  "metrics": [
    "sacrebleu",
    "chrf",
    "latency",
    "manual_error_analysis"
  ],
  "responsible_use": "Human review required; do not submit sensitive or decision-critical text.",
  "deployment": {
    "public_portfolio_target": "hugging_face_static_space",
    "browser_runtime": "Transformers.js 3.8.1 with ONNX Runtime Web",
    "browser_models": {
      "en_hi": "Xenova/opus-mt-en-hi",
      "hi_en": "Xenova/opus-mt-hi-en"
    },
    "browser_dtype_preference": "q4 with q8 fallback",
    "server_inference_required": false,
    "paid_compute_required": false
  }
}
